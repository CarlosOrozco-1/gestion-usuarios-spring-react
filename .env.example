# Configuración de entorno para el backend (Spring Boot)
# Copia este archivo a `.env` y ajusta los valores según el ambiente.

# Puerto HTTP del servidor
SERVER_PORT=8080

# Base de datos (SQLite por defecto; usa el perfil `postgres` para PostgreSQL)
DB_URL=jdbc:sqlite:gestion_usuarios.db
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=CambiaEstaClavePorUnaSecretaLargaYSegura2026!
JWT_ISSUER=GestionUsuariosAPI
JWT_EXPIRATION_HOURS=8

# CORS: origenes permitidos separados por comas
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Directorio de logs (Logback)
LOG_DIR=logs
