{
  "info": {
    "name": "Gestion de Usuarios API",
    "description": "Collection for the user management system.\n\n## Environment Variables\n- `base_url`: `http://localhost:8080`\n- `token`: Auto-populated after login\n- `user_id`, `client_id`, `credential_id`, `role_id`, `permission_id`: Set manually from responses",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "System Users",
      "item": [
        {
          "name": "List all system users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/system-users",
              "host": ["{{base_url}}"],
              "path": ["api", "system-users"]
            }
          }
        },
        {
          "name": "Get system user by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/system-users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "system-users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Create system user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idNumber\": \"1234567890\",\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"securepass123\",\n  \"roleId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/system-users",
              "host": ["{{base_url}}"],
              "path": ["api", "system-users"]
            }
          }
        },
        {
          "name": "Update system user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idNumber\": \"1234567890\",\n  \"name\": \"John Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"roleId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/system-users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "system-users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Deactivate system user (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/system-users/{{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "system-users", "{{user_id}}"]
            }
          }
        },
        {
          "name": "Reactivate system user",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/system-users/{{user_id}}/reactivate",
              "host": ["{{base_url}}"],
              "path": ["api", "system-users", "{{user_id}}", "reactivate"]
            }
          }
        }
      ]
    },
